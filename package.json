{
  "name": "windowprime-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
